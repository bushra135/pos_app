// Merge INSIDE the existing /databases/{database}/documents block.
// Do not replace existing application rules with this snippet.
// Existing broad allow rules must be narrowed: Firestore allows a request
// when ANY matching allow succeeds, so this snippet cannot override them.
match /stores/{storeCode}/backups/{backupId} {
  function backupOwner() {
    return request.auth != null
      && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'
      && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.storeCode == storeCode;
  }
  allow read: if backupOwner();
  allow create: if backupOwner()
    && request.resource.data.storeCode == storeCode
    && request.resource.data.ownerUid == request.auth.uid;
  allow update: if backupOwner()
    && resource.data.complete == false
    && request.resource.data.storeCode == resource.data.storeCode
    && request.resource.data.ownerUid == resource.data.ownerUid;
  allow delete: if false;
  match /{kind}/{recordId} {
    allow read: if backupOwner() && kind in ['products', 'sales'];
    allow create: if backupOwner() && kind in ['products', 'sales']
      && request.resource.data.storeCode == storeCode
      && get(/databases/$(database)/documents/stores/$(storeCode)/backups/$(backupId)).data.complete == false;
    allow update, delete: if false;
  }
}
