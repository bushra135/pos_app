rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function enabled() {
      return verified() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().get('isActive', true) != false
        && !(profile().get('status', '') in ['disabled', 'pending']);
    }
    function owner(code) {
      return enabled() && profile().role == 'owner' && profile().storeCode == code
        && get(/databases/$(database)/documents/stores/$(code)).data.ownerUid == request.auth.uid;
    }
    function member(code) {
      return enabled() && profile().storeCode == code
        && ((profile().role == 'owner' && owner(code))
          || (profile().role == 'cashier' && profile().get('isActive', false) == true));
    }
    function activeAccount() { return enabled() && member(profile().storeCode); }
    // Permissions the owner grants per cashier; a missing flag means "not allowed".
    function granted(flag) { return profile().get(flag, false) == true; }

    match /users/{uid} {
      allow get: if signedIn() && (uid == request.auth.uid || owner(resource.data.storeCode));
      allow list: if owner(resource.data.storeCode);
      // A new owner can claim only the new store created in the SAME batch.
      allow create: if signedIn() && uid == request.auth.uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['uid','fullName','email','role','storeName','storeCode','createdAt','isActive','status'])
        && ((request.resource.data.role == 'owner'
          && !exists(/databases/$(database)/documents/stores/$(request.resource.data.storeCode))
          && getAfter(/databases/$(database)/documents/stores/$(request.resource.data.storeCode)).data.ownerUid == uid)
        || (request.resource.data.role == 'cashier'
          && request.resource.data.isActive == false && request.resource.data.status == 'pending'
          && exists(/databases/$(database)/documents/stores/$(request.resource.data.storeCode))));
      // Invites and account approval belong to the owner, never to the cashier.
      // Only the fields the invite screen writes; anything extra is rejected.
      allow create: if owner(request.resource.data.storeCode)
        && request.resource.data.keys().hasOnly(['uid','fullName','email','role','storeCode','isActive','status','createdAt','createdBy'])
        && request.resource.data.role == 'cashier' && request.resource.data.uid == ''
        && request.resource.data.status == 'invited';
      // Own profile: name, duty, optional phone, and the email only once Firebase Auth
      // has confirmed it (it must equal the signed-in email).
      allow update: if (signedIn() && uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName','onDuty','updatedAt','phone','email','photo'])
        && (!('email' in request.resource.data.diff(resource.data).affectedKeys())
          || request.resource.data.email == request.auth.token.email)
        && (!('photo' in request.resource.data.diff(resource.data).affectedKeys())
          || !('photo' in request.resource.data)
          || (request.resource.data.photo is string && request.resource.data.photo.size() <= 120000
            && request.resource.data.photo.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$')))
        && (!('phone' in request.resource.data.diff(resource.data).affectedKeys())
          || (request.resource.data.phone is string && request.resource.data.phone.size() <= 20)))
        || (owner(resource.data.storeCode) && resource.data.role == 'cashier'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName','isActive','status','updatedAt','canEditProducts','canAdjustStock'])
        && request.resource.data.get('canEditProducts', false) is bool
        && request.resource.data.get('canAdjustStock', false) is bool);
      allow delete: if owner(resource.data.storeCode) && resource.data.role == 'cashier';
    }
    match /stores/{code} {
      allow read: if member(code);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.storeCode == code
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.storeCode == code;
      // Owner settings, including the VAT invoice details (NBR): registration flag,
      // 15-digit VAT account number (empty when not registered) and the store address.
      allow update: if owner(code)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['storeName','benefitNumber','benefitQrBase64','updatedAt','vatRegistered','vatNumber','storeAddress','sharedPriceSales','sharedPriceMax'])
        // Unregistered products: may cashiers sell at the shared reference price, and up to what price.
        && request.resource.data.get('sharedPriceSales', false) is bool
        && request.resource.data.get('sharedPriceMax', 0) is number
        && request.resource.data.get('sharedPriceMax', 0) >= 0
        && request.resource.data.get('sharedPriceMax', 0) <= 1000
        && request.resource.data.get('vatRegistered', false) is bool
        && request.resource.data.get('vatNumber', '') is string
        && (request.resource.data.get('vatNumber', '') == '' || request.resource.data.get('vatNumber', '').matches('^[0-9]{15}$'))
        && (request.resource.data.get('vatRegistered', false) == false || request.resource.data.get('vatNumber', '').size() == 15)
        && request.resource.data.get('storeAddress', '') is string
        && request.resource.data.get('storeAddress', '').size() <= 200;
      allow delete: if false;
      match /backups/{backupId} {
        allow read: if owner(code);
        allow create: if owner(code) && request.resource.data.storeCode == code
          && request.resource.data.ownerUid == request.auth.uid && request.resource.data.complete == false;
        allow update: if owner(code) && resource.data.complete == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['complete','completedAt']);
        allow delete: if false;
        match /{kind}/{recordId} {
          allow read: if owner(code) && kind in ['products','sales'];
          allow create: if owner(code) && kind in ['products','sales']
            && request.resource.data.storeCode == code
            && get(/databases/$(database)/documents/stores/$(code)/backups/$(backupId)).data.complete == false;
          allow update, delete: if false;
        }
      }
    }
    function claimed(data, id) {
      return data.get('barcode', '') != ''
        && getAfter(/databases/$(database)/documents/productBarcodes/$(data.storeCode + '_' + data.barcode)).data.productId == id;
    }
    match /productBarcodes/{claimId} {
      allow get: if activeAccount() && (!exists(/databases/$(database)/documents/productBarcodes/$(claimId)) || member(resource.data.storeCode));
      allow list: if member(resource.data.storeCode);
      allow create, update: if member(request.resource.data.storeCode)
        && (owner(request.resource.data.storeCode) || granted('canEditProducts'))
        && request.resource.data.keys().hasOnly(['storeCode','barcode','productId'])
        && request.resource.data.barcode is string && request.resource.data.barcode.size() > 0
        && claimId == request.resource.data.storeCode + '_' + request.resource.data.barcode
        && getAfter(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.storeCode == request.resource.data.storeCode
        && getAfter(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.barcode == request.resource.data.barcode
        && (resource == null || resource.data.productId == request.resource.data.productId
          || !exists(/databases/$(database)/documents/products/$(resource.data.productId)));
      allow delete: if member(resource.data.storeCode)
        && (owner(resource.data.storeCode) || granted('canEditProducts'))
        && (!existsAfter(/databases/$(database)/documents/products/$(resource.data.productId))
          || getAfter(/databases/$(database)/documents/products/$(resource.data.productId)).data.barcode != resource.data.barcode);
    }
    match /products/{id} {
      allow get: if activeAccount() && (!exists(/databases/$(database)/documents/products/$(id)) || member(resource.data.storeCode));
      allow list: if member(resource.data.storeCode);
      allow create: if owner(request.resource.data.storeCode) && claimed(request.resource.data, id);
      // Unknown items never create permanent inventory; only the owner approves products.
      allow update: if owner(resource.data.storeCode) && request.resource.data.storeCode == resource.data.storeCode
        && (request.resource.data.get('barcode', '') == resource.data.get('barcode', '') || claimed(request.resource.data, id));
      // Cashiers the owner allowed may edit catalogue details (not stock) in their store.
      // Sale linkage and correction audit fields remain transaction-controlled.
      allow update: if member(resource.data.storeCode) && profile().role == 'cashier'
        && granted('canEditProducts')
        && (request.resource.data.get('barcode', '') == resource.data.get('barcode', '') || claimed(request.resource.data, id))
        && request.resource.data.storeCode == resource.data.storeCode
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','category','price','minStock','barcode','image','catalogueSource','updatedAt','brand','size','description'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.price is number && request.resource.data.price >= 0
        && request.resource.data.stock is int && request.resource.data.stock >= 0
        && request.resource.data.get('minStock', 0) is int && request.resource.data.get('minStock', 0) >= 0
        && request.resource.data.get('category', '') is string
        && request.resource.data.get('barcode', '') is string
        && request.resource.data.get('image', '') is string;
      // Checkout stock changes must still link to a new receipt of their own.
      allow update: if member(resource.data.storeCode) && profile().role == 'cashier'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock','quantity','lastStockCorrection','lastSaleId'])
        && request.resource.data.stock is int && request.resource.data.stock >= 0
        && request.resource.data.stock <= resource.data.get('stock', resource.data.get('quantity', 0))
        && request.resource.data.get('quantity', request.resource.data.stock) == request.resource.data.stock
        && !exists(/databases/$(database)/documents/sales/$(request.resource.data.lastSaleId))
        && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastSaleId)).data.cashierUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastSaleId)).data.storeCode == resource.data.storeCode
        && id in getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastSaleId)).data.productIds;
      // Cashiers the owner allowed may count, restock or write off stock, but every change
      // must arrive with its own new stock-move record that matches the change exactly.
      allow update: if member(resource.data.storeCode) && profile().role == 'cashier'
        && granted('canAdjustStock')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock','quantity','updatedAt','lastStockMoveId'])
        && request.resource.data.stock is int && request.resource.data.stock >= 0
        && request.resource.data.get('quantity', request.resource.data.stock) == request.resource.data.stock
        && !exists(/databases/$(database)/documents/stockMoves/$(request.resource.data.lastStockMoveId))
        && getAfter(/databases/$(database)/documents/stockMoves/$(request.resource.data.lastStockMoveId)).data.productId == id
        && getAfter(/databases/$(database)/documents/stockMoves/$(request.resource.data.lastStockMoveId)).data.byUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/stockMoves/$(request.resource.data.lastStockMoveId)).data.after == request.resource.data.stock
        && getAfter(/databases/$(database)/documents/stockMoves/$(request.resource.data.lastStockMoveId)).data.before == resource.data.get('stock', resource.data.get('quantity', 0));
      allow delete: if owner(resource.data.storeCode)
        || (member(resource.data.storeCode) && granted('canEditProducts'));
    }
    // Every stock change outside a sale, with who, why, before and after. Owners read it.
    match /stockMoves/{moveId} {
      allow read: if owner(resource.data.storeCode);
      allow create: if member(request.resource.data.storeCode)
        && (profile().role == 'owner' || granted('canAdjustStock'))
        && request.resource.data.byUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['storeCode','productId','productName','before','after','delta','reason','byUid','byName','createdAt'])
        && request.resource.data.before is int && request.resource.data.after is int
        && request.resource.data.after >= 0
        && request.resource.data.delta == request.resource.data.after - request.resource.data.before
        && request.resource.data.reason in ['restock','count_correction','damaged','other']
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.storeCode == request.resource.data.storeCode;
      allow update, delete: if false;
    }
    // Cost prices live apart from products, so only the owner can read them.
    match /productCosts/{productId} {
      allow read: if owner(resource.data.storeCode);
      allow create, update: if owner(request.resource.data.storeCode)
        && request.resource.data.keys().hasOnly(['storeCode','cost','updatedAt'])
        && request.resource.data.cost is number && request.resource.data.cost >= 0
        && (resource == null || resource.data.storeCode == request.resource.data.storeCode)
        && get(/databases/$(database)/documents/products/$(productId)).data.storeCode == request.resource.data.storeCode;
      allow delete: if owner(resource.data.storeCode);
    }
    function validUnknownSale(data) {
      let item = data.items[0];
      let store = get(/databases/$(database)/documents/stores/$(data.storeCode)).data;
      let shared = get(/databases/$(database)/documents/catalog/$(item.barcode)).data;
      return data.items.size() == 1 && data.productIds == [item.productId]
        && item.barcode.matches('^([0-9]{8}|[0-9]{12,14})$')
        && item.productId == 'unknown_' + data.storeCode + '_' + item.barcode
        && data.unknownBarcode == item.barcode
        && data.pricingPolicy == 'owner_authorized_shared_reference'
        && store.get('sharedPriceSales', false) == true
        && shared.get('contributedBy', '') == 'store'
        && item.price is number && item.price > 0 && item.price == shared.get('price', -1)
        && item.price <= store.get('sharedPriceMax', 0)
        && item.quantity is int && item.quantity > 0
        && data.discount == 0 && data.get('offerDiscount', 0) == 0
        && math.abs(data.subtotal - item.price * item.quantity) < 0.0005;
    }
    match /sales/{id} {
      allow get: if activeAccount() && (!exists(/databases/$(database)/documents/sales/$(id))
        || owner(resource.data.storeCode)
        || (member(resource.data.storeCode) && resource.data.cashierUid == request.auth.uid));
      allow list: if owner(resource.data.storeCode)
        || (member(resource.data.storeCode) && resource.data.cashierUid == request.auth.uid);
      allow create: if (request.resource.data.get('unknownBarcode', '') == ''
          && (request.resource.data.get('items', []).size() == 0 || !request.resource.data.items[0].get('productId', '').matches('^unknown_.*'))
          && owner(request.resource.data.storeCode))
        || (member(request.resource.data.storeCode) && request.resource.data.cashierUid == request.auth.uid
        && request.resource.data.id == id && request.resource.data.status == 'completed'
        && request.resource.data.type == 'sale' && request.resource.data.items is list
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 100
        && request.resource.data.total is number && request.resource.data.total >= 0
        && request.resource.data.subtotal is number && request.resource.data.discount is number
        && request.resource.data.discount >= 0
        && request.resource.data.discount <= request.resource.data.subtotal
        && math.abs(request.resource.data.total - (request.resource.data.subtotal - request.resource.data.discount)) < 0.0005
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt <= request.time + duration.value(10, 'm')
        && request.resource.data.createdAt >= request.time - duration.value(30, 'd')
        && request.resource.data.syncedAt == request.time
        && request.resource.data.productIds is list
        && ((request.resource.data.get('unknownBarcode', '') == ''
            && !request.resource.data.items[0].get('productId', '').matches('^unknown_.*'))
          || validUnknownSale(request.resource.data)));
      allow update, delete: if false;
    }
    // Barcode details shared between stores: name, category, compact image and a suggested
    // price. Stock and store identity are never stored. The first store to save a barcode
    // wins, and entries cannot be changed or listed.
    match /catalog/{code} {
      allow get: if activeAccount() && (!exists(/databases/$(database)/documents/catalog/$(code)) || resource.data.get('contributedBy', '') == 'store');
      allow list: if false;
      allow create: if activeAccount()
        && code.matches('^([0-9]{8}|[0-9]{12,14})$')
        && request.resource.data.keys().hasOnly(['name','category','price','priceAt','image','brand','size','description','source','contributedBy','createdAt'])
        && (!('price' in request.resource.data)
          || (request.resource.data.price is number
            && request.resource.data.price > 0 && request.resource.data.price <= 100000
            && (owner(profile().storeCode) || granted('canEditProducts'))))
        // A shared price always carries the server time it was shared.
        && (!('priceAt' in request.resource.data)
          || ('price' in request.resource.data && request.resource.data.priceAt == request.time))
        && request.resource.data.get('brand', '') is string && request.resource.data.get('brand', '').size() <= 60
        && request.resource.data.get('size', '') is string && request.resource.data.get('size', '').size() <= 40
        && request.resource.data.get('description', '') is string && request.resource.data.get('description', '').size() <= 300
        && request.resource.data.get('source', '') is string && request.resource.data.get('source', '').size() <= 40
        && (!('image' in request.resource.data)
          || (request.resource.data.image is string && request.resource.data.image.size() <= 250000
            && request.resource.data.image.matches('^(data:image/|https://).*')))
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.category is string && request.resource.data.category.size() <= 60
        && request.resource.data.contributedBy == 'store'
        && request.resource.data.createdAt == request.time;
      // Fill-in only: an active store may add a price, photo, brand, size or description
      // the entry is missing. Existing values (name, category, price, image, author) never change.
      allow update: if activeAccount()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['price','priceAt','image','brand','size','description'])
        && (!('priceAt' in request.resource.data) || ('priceAt' in resource.data)
          || (('price' in request.resource.data) && !('price' in resource.data)
            && request.resource.data.priceAt == request.time))
        && request.resource.data.get('brand', '') is string && request.resource.data.get('brand', '').size() <= 60
        && request.resource.data.get('size', '') is string && request.resource.data.get('size', '').size() <= 40
        && request.resource.data.get('description', '') is string && request.resource.data.get('description', '').size() <= 300
        && request.resource.data.diff(resource.data).changedKeys().size() == 0
        && request.resource.data.diff(resource.data).removedKeys().size() == 0
        && (!('price' in request.resource.data) || ('price' in resource.data)
          || (request.resource.data.price is number
            && request.resource.data.price > 0 && request.resource.data.price <= 100000
            && (owner(profile().storeCode) || granted('canEditProducts'))))
        && (!('image' in request.resource.data) || ('image' in resource.data)
          || (request.resource.data.image is string && request.resource.data.image.size() <= 250000
            && request.resource.data.image.matches('^(data:image/|https://).*')));
      allow delete: if false;
    }
    // A cashier asks the owner to add an unknown barcode. One request per store and
    // barcode (id storeCode_barcode). Only the owner sees all requests and removes them
    // once added or declined; nothing here ever changes stock or prices.
    match /productRequests/{id} {
      allow get: if member(resource.data.storeCode)
        && (profile().role == 'owner' || resource.data.requestedBy == request.auth.uid);
      allow list: if owner(resource.data.storeCode);
      allow create: if member(request.resource.data.storeCode)
        && id == request.resource.data.storeCode + '_' + request.resource.data.barcode
        && request.resource.data.barcode is string
        && request.resource.data.barcode.matches('^([0-9]{8}|[0-9]{12,14})$')
        && request.resource.data.keys().hasOnly(['storeCode','barcode','name','brand','category','image','size','description','sharedPrice','requestedBy','requestedByName','createdAt'])
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 80
        && request.resource.data.get('brand', '') is string && request.resource.data.get('brand', '').size() <= 60
        && request.resource.data.get('category', '') is string && request.resource.data.get('category', '').size() <= 60
        && request.resource.data.get('size', '') is string && request.resource.data.get('size', '').size() <= 40
        && request.resource.data.get('description', '') is string && request.resource.data.get('description', '').size() <= 300
        && request.resource.data.get('requestedByName', '') is string && request.resource.data.get('requestedByName', '').size() <= 80
        && request.resource.data.get('image', '') is string && request.resource.data.get('image', '').size() <= 250000
        && (request.resource.data.get('image', '') == '' || request.resource.data.get('image', '').matches('^(data:image/|https://).*'))
        && request.resource.data.get('sharedPrice', 0) is number && request.resource.data.get('sharedPrice', 0) >= 0
        && (request.resource.data.get('sharedPrice', 0) == 0
          || (get(/databases/$(database)/documents/catalog/$(request.resource.data.barcode)).data.get('contributedBy', '') == 'store'
            && request.resource.data.sharedPrice == get(/databases/$(database)/documents/catalog/$(request.resource.data.barcode)).data.get('price', -1)));
      allow update: if false;
      allow delete: if owner(resource.data.storeCode);
    }
    // Every collection that is not explicitly covered stays closed.
    match /{document=**} { allow read, write: if false; }
  }
}
