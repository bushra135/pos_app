rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function enabled() {
      return verified() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().get('isActive', true) != false
        && !(profile().get('status', '') in ['disabled', 'pending']);
    }
    function owner(code) {
      return enabled() && profile().role == 'owner' && profile().storeCode == code
        && get(/databases/$(database)/documents/stores/$(code)).data.ownerUid == request.auth.uid;
    }
    function member(code) {
      return enabled() && profile().storeCode == code
        && ((profile().role == 'owner' && owner(code))
          || (profile().role == 'cashier' && profile().get('isActive', false) == true));
    }
    function activeAccount() { return enabled() && member(profile().storeCode); }

    match /users/{uid} {
      allow get: if signedIn() && (uid == request.auth.uid || owner(resource.data.storeCode));
      allow list: if owner(resource.data.storeCode);
      // A new owner can claim only the new store created in the SAME batch.
      allow create: if signedIn() && uid == request.auth.uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['uid','fullName','email','role','storeName','storeCode','createdAt','isActive','status'])
        && ((request.resource.data.role == 'owner'
          && !exists(/databases/$(database)/documents/stores/$(request.resource.data.storeCode))
          && getAfter(/databases/$(database)/documents/stores/$(request.resource.data.storeCode)).data.ownerUid == uid)
        || (request.resource.data.role == 'cashier'
          && request.resource.data.isActive == false && request.resource.data.status == 'pending'
          && exists(/databases/$(database)/documents/stores/$(request.resource.data.storeCode))));
      // Invites and account approval belong to the owner, never to the cashier.
      allow create: if owner(request.resource.data.storeCode)
        && request.resource.data.role == 'cashier' && request.resource.data.uid == ''
        && request.resource.data.status == 'invited';
      allow update: if (signedIn() && uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName','onDuty','updatedAt']))
        || (owner(resource.data.storeCode) && resource.data.role == 'cashier'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName','isActive','status','updatedAt']));
      allow delete: if owner(resource.data.storeCode) && resource.data.role == 'cashier';
    }
    match /stores/{code} {
      allow read: if member(code);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.storeCode == code
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.storeCode == code;
      allow update: if owner(code)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['storeName','benefitNumber','benefitQrBase64','updatedAt']);
      allow delete: if false;
      match /backups/{backupId} {
        allow read: if owner(code);
        allow create: if owner(code) && request.resource.data.storeCode == code
          && request.resource.data.ownerUid == request.auth.uid && request.resource.data.complete == false;
        allow update: if owner(code) && resource.data.complete == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['complete','completedAt']);
        allow delete: if false;
        match /{kind}/{recordId} {
          allow read: if owner(code) && kind in ['products','sales'];
          allow create: if owner(code) && kind in ['products','sales']
            && request.resource.data.storeCode == code
            && get(/databases/$(database)/documents/stores/$(code)/backups/$(backupId)).data.complete == false;
          allow update, delete: if false;
        }
      }
    }
    match /products/{id} {
      allow get: if activeAccount() && (!exists(/databases/$(database)/documents/products/$(id)) || member(resource.data.storeCode));
      allow list: if member(resource.data.storeCode);
      allow create: if owner(request.resource.data.storeCode);
      allow update: if owner(resource.data.storeCode) && request.resource.data.storeCode == resource.data.storeCode;
      // Approved cashiers may edit catalogue details in their own store.
      // Sale linkage and correction audit fields remain transaction-controlled.
      allow update: if member(resource.data.storeCode) && profile().role == 'cashier'
        && request.resource.data.storeCode == resource.data.storeCode
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','category','price','stock','minStock','barcode','image','catalogueSource','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.price is number && request.resource.data.price >= 0
        && request.resource.data.stock is int && request.resource.data.stock >= 0
        && request.resource.data.get('minStock', 0) is int && request.resource.data.get('minStock', 0) >= 0
        && request.resource.data.get('category', '') is string
        && request.resource.data.get('barcode', '') is string
        && request.resource.data.get('image', '') is string;
      // Checkout stock changes must still link to a new receipt of their own.
      allow update: if member(resource.data.storeCode) && profile().role == 'cashier'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock','quantity','lastStockCorrection','lastSaleId'])
        && request.resource.data.stock is int && request.resource.data.stock >= 0
        && request.resource.data.stock <= resource.data.get('stock', resource.data.get('quantity', 0))
        && request.resource.data.get('quantity', request.resource.data.stock) == request.resource.data.stock
        && !exists(/databases/$(database)/documents/sales/$(request.resource.data.lastSaleId))
        && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastSaleId)).data.cashierUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastSaleId)).data.storeCode == resource.data.storeCode
        && id in getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastSaleId)).data.productIds;
      allow delete: if member(resource.data.storeCode);
    }
    match /sales/{id} {
      allow get: if activeAccount() && (!exists(/databases/$(database)/documents/sales/$(id))
        || owner(resource.data.storeCode)
        || (member(resource.data.storeCode) && resource.data.cashierUid == request.auth.uid));
      allow list: if owner(resource.data.storeCode)
        || (member(resource.data.storeCode) && resource.data.cashierUid == request.auth.uid);
      allow create: if owner(request.resource.data.storeCode)
        || (member(request.resource.data.storeCode) && request.resource.data.cashierUid == request.auth.uid
        && request.resource.data.id == id && request.resource.data.status == 'completed'
        && request.resource.data.type == 'sale' && request.resource.data.items is list
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 100
        && request.resource.data.total is number && request.resource.data.total >= 0
        && request.resource.data.productIds is list);
      allow update, delete: if false;
    }
    // Every collection that is not explicitly covered stays closed.
    match /{document=**} { allow read, write: if false; }
  }
}
